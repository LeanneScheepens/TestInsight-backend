<mxfile host="app.diagrams.net" modified="2026-11-06T09:00:00.000Z" agent="GitHub Copilot" version="24.7.17" type="device">
  <diagram id="cucumber-import-flow" name="Cucumber import flow">
    <mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cucumber import — POST /api/import/cucumber" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="880" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Client / CI pipeline&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST http://localhost:8080/api/import/cucumber&lt;br&gt;Header: X-Application-Name&lt;br&gt;Body: Cucumber JSON feature array&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="controller" value="TestResultImportController&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Binds request header and JSON body&lt;br&gt;Calls importCucumberResults(...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="220" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="service" value="TestResultImportService&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Starts transactional import; records receivedAt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="350" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="validate" value="Validate Cucumber report&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Must be a non-empty array; feature and scenario names required; elements/steps must have expected shapes&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="400" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="invalid" value="Invalid input&lt;br&gt;Throws validation exception;&lt;br&gt;import stops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1010" y="495" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Find or create Application&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Look up by application name; insert if not found&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="640" width="400" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="process" value="CucumberScenarioProcessor&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Walks features; keeps scenario/scenario_outline elements; extracts IDs, names, outcome, failed step, error and source JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="765" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="setup" value="Prepare import&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Generate one runId; count features/scenarios; register attachment cleanup for rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="905" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="loop" value="For each extracted scenario" style="swimlane;html=1;startSize=30;rounded=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="1030" width="1200" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="testcase" value="Find or create TestCase&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Key: application + CUCUMBER + feature ID + scenario ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1100" width="250" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="attachments" value="Process attachments&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Validate supported image and size; decode base64 to file; replace data with storage URI in copied JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="1090" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="save" value="Map and save TestResult&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Attach TestCase, runId, status, timestamps, failure details and sanitized source payload; database generates result ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="1090" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="next" value="More scenarios?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1095" width="120" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="commit" value="Transaction commits&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;On success, saved attachments are retained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1380" width="400" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="response" value="HTTP response&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ImportResponse: runId, featuresImported, scenariosImported&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1490" width="400" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="rollback" value="Import fails&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Transaction rolls back; attachment files created so far are deleted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="1320" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="client" target="controller">
